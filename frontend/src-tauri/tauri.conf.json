{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GoreeCloud PDF Manager",
  "mainBinaryName": "goreecloud-pdf-manager",
  "version": "0.1.0",
  "identifier": "com.goreecloud.pdfmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npx --no-install vite --mode core --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "npx --no-install vite build --mode core"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "publisher": "GoreeCloud",
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app",
      "msi"
    ],
    "icon": [
      "icons/windows/app.ico",
      "icons/macos/app.icns",
      "icons/macos/app-512.png"
    ],
    "resources": [
      "libs/*.jar",
      "runtime/jre/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "stirling-pdf.desktop"
      },
      "rpm": {
        "desktopTemplate": "stirling-pdf.desktop",
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "upgradeCode": "3839c74e-d9a8-4a01-b997-6b2c287a805c",
        "bannerPath": "windows/wix/banner.bmp",
        "dialogImagePath": "windows/wix/dialog.bmp",
        "fragmentPaths": [
          "windows/wix/provisioning.wxs"
        ],
        "componentGroupRefs": [
          "ProvisioningComponentGroup"
        ]
      }
    },
    "macOS": {
      "dmg": {
        "background": "macos/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 200,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 210
        }
      },
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "goreecloudpdf"
        ]
      }
    }
  }
}
